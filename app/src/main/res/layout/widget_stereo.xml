<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layoutDirection="ltr"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp"
    android:background="@drawable/widget_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <ImageView
            android:id="@+id/w_icon"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:contentDescription="Cambridge Connect Legacy"
            android:src="@drawable/ic_launcher" />
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:orientation="vertical">
            <TextView
                android:id="@+id/w_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Cambridge Connect Legacy"
                android:textColor="#ECEDEF"
                android:textSize="14sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/w_sub"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Tap to open"
                android:textColor="#9BA0AA"
                android:textSize="12sp" />
        </LinearLayout>
        <ImageView
            android:id="@+id/w_play"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/widget_play_bg"
            android:contentDescription="Play or pause"
            android:padding="11dp"
            android:src="@android:drawable/ic_media_pause"
            android:tint="#0B0C0F" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/w_down"
            android:layout_width="52dp"
            android:layout_height="40dp"
            android:background="@drawable/widget_btn"
            android:gravity="center"
            android:contentDescription="Volume down"
            android:text="−"
            android:textColor="#ECEDEF"
            android:textSize="22sp" />
        <TextView
            android:id="@+id/w_vol"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Vol –"
            android:textColor="#E8A33D"
            android:textSize="16sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/w_up"
            android:layout_width="52dp"
            android:layout_height="40dp"
            android:background="@drawable/widget_btn"
            android:gravity="center"
            android:contentDescription="Volume up"
            android:text="+"
            android:textColor="#ECEDEF"
            android:textSize="22sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">
        <TextView android:id="@+id/w_in0" android:layout_width="0dp" android:layout_height="36dp" android:layout_weight="1"
            android:layout_marginEnd="6dp" android:visibility="gone" android:paddingStart="4dp" android:paddingEnd="4dp"
            android:background="@drawable/widget_btn" android:gravity="center" android:maxLines="1" android:ellipsize="end"
            android:text="" android:textColor="#ECEDEF" android:textSize="12sp" />
        <TextView android:id="@+id/w_in1" android:layout_width="0dp" android:layout_height="36dp" android:layout_weight="1"
            android:layout_marginEnd="6dp" android:visibility="gone" android:paddingStart="4dp" android:paddingEnd="4dp"
            android:background="@drawable/widget_btn" android:gravity="center" android:maxLines="1" android:ellipsize="end"
            android:text="" android:textColor="#ECEDEF" android:textSize="12sp" />
        <TextView android:id="@+id/w_in2" android:layout_width="0dp" android:layout_height="36dp" android:layout_weight="1"
            android:layout_marginEnd="6dp" android:visibility="gone" android:paddingStart="4dp" android:paddingEnd="4dp"
            android:background="@drawable/widget_btn" android:gravity="center" android:maxLines="1" android:ellipsize="end"
            android:text="" android:textColor="#ECEDEF" android:textSize="12sp" />
        <TextView android:id="@+id/w_in3" android:layout_width="0dp" android:layout_height="36dp" android:layout_weight="1"
            android:layout_marginEnd="6dp" android:visibility="gone" android:paddingStart="4dp" android:paddingEnd="4dp"
            android:background="@drawable/widget_btn" android:gravity="center" android:maxLines="1" android:ellipsize="end"
            android:text="" android:textColor="#ECEDEF" android:textSize="12sp" />
        <TextView android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="0.001" />
        <ImageView android:id="@+id/w_power" android:layout_width="44dp" android:layout_height="36dp"
            android:padding="8dp"
            android:background="@drawable/widget_btn"
            android:contentDescription="Power: standby or wake"
            android:src="@android:drawable/ic_lock_power_off" />
    </LinearLayout>
</LinearLayout>
